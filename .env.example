# ==========================================================
# PP LMS — Environment Configuration
# ==========================================================
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.
# ==========================================================

# Database Configuration
DB_HOST=127.0.0.1
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password

# ── reCAPTCHA (Anti-bot) ──
# Google reCAPTCHA v2 keys for signup form protection.
# Get yours at: https://www.google.com/recaptcha/admin
RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# ── API Authentication Key ──
# Required for all /api/* webhook endpoints (register, enroll, invite, revoke).
# Requests must include header: X-API-Key: <this-key>
# or Authorization: Bearer <this-key>
# Leave blank to require admin session authentication only (not recommended for production).
API_KEY=your_api_key_here

# ── S3 SCORM Prefix (Optional) ──
# The S3 object-key prefix used for SCORM package storage.
# Change this to namespace different LMS instances within the same bucket.
# Defaults to "hpcas/" if not set.
S3_SCORM_PREFIX=hpcas/

# ── Native SCORM Reader (Optional) ──
# Location where uploaded SCORM packages are extracted and stored.
# Defaults to {docroot}/content/scorm if left blank. Files there are
# protected from direct access and served via /scorm-content/serve.php
# SCORM_STORAGE_PATH=/absolute/path/to/scorm/storage

# SCORM Backend Selection:
#   native — use the native SCORM reader tables only
#   moodle — use the Moodle API bridge only (legacy)
#   auto   — use native when native packages/data exist, else Moodle (default)
SCORM_BACKEND=auto

# SCORM runtime compatibility mode:
#   1 (default) — accept cross-version spellings (1.2 elements on 2004 packages
#                 and vice versa) for maximum Storyline/Rise compatibility.
#   0           — strict mode: content must use exactly the declared SCORM API.
SCORM_COMPAT_MODE=1

# Cross-version analytics dashboards (completion-vs-pass, interaction accuracy,
# score distribution, telemetry completeness, persistence monitoring).
# Set to 1 to enable; off by default.
ANALYTICS_V2=0

# ── Security hardening (lockout, throttling, MFA) ──
# Comma-separated list of admin alert recipients. Falls back to all verified
# super_admin users when empty.
ADMIN_ALERT_EMAIL=
# Account lockout: max_failures failed logins within window_secs locks the
# account for lock_minutes. Per-IP throttling uses the same parameters.
LOGIN_LOCKOUT_MAX=5
LOGIN_LOCKOUT_WINDOW_SECS=300
LOGIN_LOCKOUT_MINUTES=5
# Email MFA code lifetime for administrators (minutes).
MFA_TTL_MINUTES=10

# ── Moodle SCORM Backend ──
# Your LMS uses Moodle for SCORM content hosting, delivery, and tracking.
# Replace these with your actual Moodle server details.
MOODLE_BASE_URL=https://moodle.yourdomain.com
MOODLE_WSTOKEN=your_moodle_webservice_token_here

# Local Test User (for localhost staging only)
TEST_USER_EMAIL=test@your-domain.local
TEST_USER_PASSWORD=Test1234!
TEST_USER_ID=test-user

# Application Domain — controls cookies, redirects, and email from-address
# Set this to the domain this instance is served from (e.g., lms.yourclient.com)
APP_DOMAIN=yourdomain.com

# Site branding — change these to rebrand the entire LMS
SITE_NAME=Your LMS Name
LOGO_FILENAME=your-logo.png
FAVICON_FILENAME=your-favicon.svg

# Email sender configuration
MAIL_FROM_EMAIL=noreply@yourdomain.com
MAIL_FROM_NAME=Your LMS Portal

# Demo signup notifications ("New Demo Signup" email) are sent to this address
# (leave blank to fall back to the per-slot notification emails on the campaign)
DEMO_SIGNUP_NOTIFY_EMAIL=your-notify-email@example.com

# GoHighLevel API (optional — leave blank to use PHP mail())
GHL_API_KEY=
GHL_LOCATION_ID=

# Application Environment
#   development — shows errors, localhost-only features enabled
#   production  — live environment
APP_ENV=production